@model List<UsuarioModel>
@{
    ViewData["Title"] = "uwusuario will be here uhhh breathes in semicolon and a parenthesis, making a winky smile this title was also made by my teacher";
}

<div class="container mx-auto p-4 space-y-6">
    <div class="flex justify-start">
        <a role="button" class="btn btn-primary rounded-none shadow-md" asp-controller="Usuario" asp-action="Criar">lets make the pizza i'm italian now wahoo</a>
    </div>

    @if(TempData["MensagemSucesso"] != null)
    {
        <div class="alert alert-info shadow-lg">
            <span>@TempData["MensagemSucesso"]</span>
            <button type="button" class="btn btn-ghost btn-xs" aria-label="Close">(,,•ω•,,)♡</button>
        </div>
    }
    @if(TempData["MensagemErro"] != null)
    {
        <div class="alert alert-error shadow-lg">
            <span>@TempData["MensagemErro"]</span>
            <button type="button" class="btn btn-ghost btn-xs" aria-label="Close">(─‿‿─)♡</button>
        </div>
    }

    <h1 class="text-3xl font-bold text-primary">look it's another listtt!</h1>

    <div class="overflow-x-auto bg-base-100 rounded-box shadow-xl p-2">
        <!-- this is fucking stupid.
             what the fuck is the ai on- whatever not important
              anyways, keep in MIND, this contatos needs to stay because it seems to be what keeps the tables stable and alive.-->
        <table class="table table-zebra w-full" id="tabela-contatos">
            <thead>
                <tr class="text-secondary text-lg">
                    <th scope="col">#</th>
                    <th scope="col">OWO</th>
                    <th scope="col">rawr</th>
                    <th scope="col">uwu</th>
                    <th scope="col">purble</th>
                    <th scope="col">:3:3:3:3:3:3:3:3:3</th>
                    <th scope="col">actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any()) {
                    foreach (var usuario in Model){
                        <tr class="hover">
                            <th scope="row">@usuario.Id</th>
                            <td class="font-bold">@usuario.Name</td>
                            <td>@usuario.Login</td>
                            <td>@usuario.Email</td>
                            <td>@(usuario.Perfil == MeowColonThree.Enuns.PerfilEnums.Adm ?  "god of hyper death" : "plebian")</td>
                            <td>@usuario.DataCadastro</td>
                            <td>
                                <div class="join">
                                    <a role="button" class="btn btn-primary btn-sm join-item" asp-route-id="@usuario.Id" asp-controller="Usuario" asp-action="Editar">edit</a>
                                    <a role="button" class="btn btn-error btn-sm join-item" asp-route-id="@usuario.Id" asp-controller="Usuario" asp-action="ApagarConfirmacao">delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
