@using MeowColonThree.Enuns
@model UsuarioModel

@{
    ViewData["Title"] = "woahgsss!!!";
}
<div class="text-center">
    <h1 class="display-4">aight who we adding?</h1>
</div>

<form asp-controller="Usuario" asp-action="Criar" method="post">
    <label class="form-control w-full mb-3">
        <div class="label">
            <span class="label-text text-lg">hey put the name of the fella here :D</span>
        </div>
        <input type="text" class="input input-bordered w-full" asp-for="Name" placeholder="mrawmramwmrawmrawrawr" />
    </label>
    <div id="emailHelp" class="form-text mb-3">fun fact this used to be a warning about emails not being used and stuff
        :3.</div>
    @Html.ValidationMessageFor(x => x.Name)

    <label class="form-control w-full mb-3">
        <div class="label">
            <span class="label-text text-lg">oh woahgs it's more silly stuff!</span>
        </div>
        <input type="text" class="input input-bordered w-full" asp-for="Email"
            placeholder="mrrrrpmrmprrmmmmrrrrrppppr" />
    </label>
    @Html.ValidationMessageFor(x => x.Email)

    <label class="form-control w-full mb-3">
        <div class="label">
            <span class="label-text text-lg">sans undertale is so cool :3</span>
        </div>
        <input type="text" class="input input-bordered w-full" asp-for="Login"
            placeholder="moewomewmoemoewmowemoewmoewomewmoewmoe" />
    </label>
    @Html.ValidationMessageFor(x => x.Login)

    <label class="form-control w-full mb-3">
        <div class="label">
            <span class="label-text text-lg">Sassy W0w0</span>
        </div>
        <input type="password" class="input input-bordered w-full" asp-for="Senha" placeholder="Sassy W0w0" />
    </label>
    @Html.ValidationMessageFor(x => x.Senha)

    <label class="form-control w-full mb-3">
        <div class="label">
            <span class="label-text text-lg">are we making a god or just a plebian</span>
        </div>
        <select asp-for="Perfil" class="select select-bordered w-full">
            <option value="">choose it idiot</option>
            <option value="@( (int)PerfilEnums.Adm )">i am admin</option>
            <option value="@( (int)PerfilEnums.Padrao )">not an admin waaaaaa</option>
        </select>
    </label>
    @Html.ValidationMessageFor(x => x.Perfil)

    <div class="flex gap-4 mt-4">
        <a class="btn btn-secondary" asp-controller="Usuario" asp-action="Index" role="button">changed ur mind?</a>
        <button type="submit" class="btn btn-primary">make the skrunkly realll!!!!</button>
    </div>
</form>