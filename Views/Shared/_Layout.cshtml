<!DOCTYPE html>
<html lang="en" data-theme="valentine">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Meow Mrrp Mrawww :3</title>
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />

</head>

<body class="min-h-screen font-ascii bg-base-100 text-base-content">
    <div class="drawer">
        <input id="my-drawer-2" type="checkbox" class="drawer-toggle" />
        <div class="drawer-content flex flex-col min-h-screen">
            <!-- Navbar / Header for Mobile -->
            <div class="w-full navbar bg-base-100 shadow-sm">
                <div class="flex-none">
                    <label for="my-drawer-2" aria-label="open sidebar" class="btn btn-square btn-ghost">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                            class="inline-block w-6 h-6 stroke-current">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </label>
                </div>
                <div class="flex-1 px-2 mx-2 text-xl font-bold text-primary">Mrrrrp mrawww :3</div>
            </div>

            <!-- Page Content -->
            <div class="flex-grow p-4 md:p-8">
                @RenderBody()
            </div>

            <footer class="footer items-center p-4 bg-neutral text-neutral-content mt-auto">
                <aside class="items-center grid-flow-col">
                    <svg width="36" height="36" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"
                        fill-rule="evenodd" clip-rule="evenodd" class="fill-current">
                        <path
                            d="M22.672 15.226l-2.432.811.841 2.515c.33 1.019-.209 2.127-1.23 2.456-1.15.325-2.148-.321-2.463-1.226l-.84-2.518-5.013 1.677.84 2.517c.391 1.203-.434 2.542-1.831 2.542-.88 0-1.601-.564-1.86-1.314l-.842-2.516-2.431.809c-1.135.378-2.314-.233-2.622-1.36-.299-1.096.353-2.155 1.353-2.48l2.432-.81-.84-2.518c-.332-1.02.207-2.127 1.228-2.46.368-.12.753-.082 1.096.071l-.478-1.503c-.266-.803.113-1.621.905-1.936l7.75-3.078c.85-.337 1.833.027 2.194.81l1.503 4.298c.397.085.795.312 1.111.666 1.087 1.23.498 3.018-.949 3.966l-.841 2.516 2.432.81c1.134.379 2.313-.233 2.62-1.361.299-1.096-.35-2.152-1.35-2.477zm-6.42-3.136c.725-.658.852-1.748.288-2.56-.566-.814-1.614-.997-2.34-.34-.725.659-.852 1.749-.286 2.562.564.813 1.613.996 2.338.338zm-4.707 9.88l5.014-1.676-.842-2.518-5.012 1.677.84 2.517z" />
                    </svg>
                    <p>Copyright © 2025 - Meowowowowowow</p>
                </aside>
            </footer>
        </div>
        <div class="drawer-side z-50">
            <label for="my-drawer-2" aria-label="close sidebar" class="drawer-overlay"></label>
            <ul class="menu p-4 w-80 min-h-full bg-base-200 text-base-content flex flex-col gap-2">
                <!-- Sidebar Header -->
                <li class="mb-4 text-center">
                    <a class="text-2xl font-bold text-primary justify-center hover:bg-transparent" asp-area=""
                        asp-controller="Home" asp-action="Index">
                        Mrrrrp mrawww
                    </a>
                </li>

                <!-- Navigation Links -->
                <li>
                    <a asp-area="" asp-controller="Home" asp-action="Index"
                        class="btn btn-sm btn-ghost justify-start content-center uppercase font-bold tracking-widest text-base-content hover:text-base-100 hover:bg-secondary">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-secondary" width="20"
                            height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                        </svg>
                        the default page
                    </a>
                </li>
                <li>
                    <a asp-area="" asp-controller="Contato" asp-action="Index"
                        class="btn btn-sm btn-ghost justify-start content-center uppercase font-bold tracking-widest text-base-content hover:text-base-100 hover:bg-accent">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-accent" width="20" height="20"
                            fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                        </svg>
                        the fockennnnn list
                    </a>
                </li>
                <li>
                    <a asp-area="" asp-controller="Usuario" asp-action="Index"
                        class="btn btn-sm btn-ghost justify-start content-center uppercase font-bold tracking-widest text-base-content hover:text-base-100 hover:bg-info">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-info" width="20" height="20"
                            fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                        the third one!!!!!
                    </a>
                </li>

                <div class="divider"></div>

                <!-- Theme Controller -->
                <li class="mt-auto">
                    <label class="toggle text-base-content toggle-xl transform scale-150 origin-bottom-left ml-4 mb-4">
                        <input type="checkbox" value="synthwave" class="theme-controller" />

                        <svg aria-label="sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <g stroke-linejoin="round" stroke-linecap="round" stroke-width="2" fill="none"
                                stroke="currentColor">
                                <circle cx="12" cy="12" r="4"></circle>
                                <path d="M12 2v2"></path>
                                <path d="M12 20v2"></path>
                                <path d="m4.93 4.93 1.41 1.41"></path>
                                <path d="m17.66 17.66 1.41 1.41"></path>
                                <path d="M2 12h2"></path>
                                <path d="M20 12h2"></path>
                                <path d="m6.34 17.66-1.41 1.41"></path>
                                <path d="m19.07 4.93-1.41 1.41"></path>
                            </g>
                        </svg>

                        <svg aria-label="moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <g stroke-linejoin="round" stroke-linecap="round" stroke-width="2" fill="none"
                                stroke="currentColor">
                                <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
                            </g>
                        </svg>
                    </label>
                </li>
            </ul>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.datatables.net/v/dt/dt-2.3.4/datatables.min.js"
        integrity="sha384-X2pTSfom8FUa+vGQ+DgTCSyBZYkC1RliOduHa0X96D060s7Q//fnOh3LcazRNHyo"
        crossorigin="anonymous"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>

