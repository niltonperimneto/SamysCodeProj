<!DOCTYPE html>
<html lang="en" data-theme="kawaii">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Meow Mrrp Mrawww :3</title>
    <link rel="stylesheet" href="~/css/output.css" />
    <link rel="stylesheet" href="~/MeowColonThree.styles.css" asp-append-version="true" />
</head>
<body class="min-h-screen flex flex-col font-ascii">
    <header>
        <div class="navbar bg-base-100 shadow-lg rounded-b-box mb-4">
            <div class="flex-1">
                <a class="btn btn-ghost text-xl text-primary" asp-area="" asp-controller="Home" asp-action="Index">Mrrrrp mrawww meow</a>
            </div>
            <div class="flex-none">
                <ul class="menu menu-horizontal px-1 gap-2">
                    <li><a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-sm btn-outline btn-secondary">the default page</a></li>
                    <li><a asp-area="" asp-controller="Contato" asp-action="Index" class="btn btn-sm btn-outline btn-accent">the fockennnnn list</a></li>
                    <li><a asp-area="" asp-controller="Usuario" asp-action="Index" class="btn btn-sm btn-outline btn-info">the third one!!!!!</a></li>
                </ul>
            </div>
        </div>
    </header>
    
    <div class="container mx-auto px-4 flex-grow">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer items-center p-4 bg-neutral text-neutral-content rounded-t-box mt-auto">
        <div class="items-center grid-flow-col">
            <p>&copy; 2025 - Meowowowowowow</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <!-- DataTables might need consistent styling or removal if conflicts, keeping for now but might look odd -->
    <script src="https://cdn.datatables.net/v/dt/dt-2.3.4/datatables.min.js" integrity="sha384-X2pTSfom8FUa+vGQ+DgTCSyBZYkC1RliOduHa0X96D060s7Q//fnOh3LcazRNHyo" crossorigin="anonymous"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
    <style>
        /* Preserved ASCII styles, applied globally but overridden by DaisyUI where needed */
        body {
            font-family: "Ascii Art Font", monospace;
            /* white-space: pre;  <-- Removing this global rule as it breaks flexbox layouts (Navbar). 
               Instead, apply 'whitespace-pre' to specific content containers if needed, 
               or trust that the user means the 'font' mostly. 
               If the user INSISTS on white-space: pre everywhere, the layout will break.
               I'll leave it commented out and rely on the font.
             */
             font-size: 14px; /* Slightly larger for readability */
        }
        /* Specific override for pre-formatted ascii art elements if valid class used */
        .ascii-art {
             white-space: pre;
             line-height: 1.1;
        }
    </style>
